# Server Configuration
PORT=3000
HOST=0.0.0.0

# Optional: MyAnimeList Official API v2 Client ID
# Get one free at https://myanimelist.net/apiconfig
# If left empty, the API automatically falls back to HTML scraping.
MAL_CLIENT_ID=

# SQLite Cache Configuration
CACHE_DB_PATH=./data/cache.db
CACHE_FRESH_TTL_MS=21600000
CACHE_STALE_TTL_MS=604800000

# Upstream Rate Limiter & Timeout
UPSTREAM_CONCURRENCY=2
UPSTREAM_MIN_INTERVAL_MS=350
UPSTREAM_TIMEOUT_MS=10000
