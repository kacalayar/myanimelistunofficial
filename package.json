{
  "name": "mal-unofficial-api",
  "version": "1.0.0",
  "description": "Fast, timeout-resistant Unofficial MyAnimeList API (Jikan v4 compatible) with Stale-While-Revalidate SQLite caching, Singleflight deduplication, Hybrid MAL API v2 + Scraper, and Web Dashboard.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "myanimelist",
    "jikan",
    "anime-api",
    "hono",
    "sqlite",
    "swr-cache"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.3",
    "@scalar/hono-api-reference": "^0.5.171",
    "cheerio": "^1.0.0",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
